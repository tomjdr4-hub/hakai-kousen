<div class="hk-sheet">
  <header class="sheet-header">
    <img class="portrait small" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img">
    <input class="actor-name" type="text" name="name" value="{{item.name}}">
  </header>

  <div class="sheet-body">
    <div class="details-grid">
      {{#if isType.attack}}
      <label>Type <select name="system.type">{{selectOptions config.TYPES selected=system.type}}</select></label>
      <label>Catégorie <select name="system.category">{{selectOptions categories selected=system.category}}</select></label>
      <label>Énergie (ENE) <input type="number" name="system.energy" value="{{system.energy}}" min="0"></label>
      <label>Portée <input type="text" name="system.range" value="{{system.range}}"></label>
      <label>Précision (%) <input type="number" name="system.accuracy" value="{{system.accuracy}}" min="0"></label>
      <label class="checkbox"><input type="checkbox" name="system.sure" {{checked system.sure}}> Ne peut pas échouer</label>
      <label data-tooltip="Formule, STAB inclus : 12, 2d6+4…">Dégâts <input type="text" name="system.damage" value="{{system.damage}}" placeholder="ex. 12 ou 2d6+4"></label>
      <label>Effet secondaire (%) <input type="number" name="system.effectChance" value="{{system.effectChance}}" min="0" max="100"></label>
      <label>Priorité
        <select name="system.priority" data-dtype="Number">{{selectOptions priorities selected=system.priority}}</select>
      </label>
      <label data-tooltip="Pour le tour où la capacité est choisie">Bonus d'initiative <input type="number" name="system.initiativeBonus" value="{{system.initiativeBonus}}"></label>
      <label>Coût d'apprentissage (XP) <input type="number" name="system.xpCost" value="{{system.xpCost}}" min="0"></label>
      {{/if}}

      {{#if isType.pokeskill}}
      <label>Niveau <input type="number" name="system.level" value="{{system.level}}" min="0"></label>
      <label>Catégorie <select name="system.category">{{selectOptions categories selected=system.category}}</select></label>
      <label>Apprentissage (/10) <input type="number" name="system.progress" value="{{system.progress}}" min="0" max="10"></label>
      <p class="hint">Prochain niveau : {{system.nextCost}} XP Pokémon.</p>
      {{/if}}

      {{#if isType.talent}}
      <label class="checkbox"><input type="checkbox" name="system.hidden" {{checked system.hidden}}> Talent caché</label>
      {{/if}}

      {{#if isType.gear}}
      <label>Catégorie <select name="system.category">{{selectOptions categories selected=system.category}}</select></label>
      <label>Quantité <input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>
      <label>Prix (₽) <input type="number" name="system.price" value="{{system.price}}" min="0"></label>
      <label>Charges <input type="number" name="system.charges" value="{{system.charges}}" min="0"></label>
      {{/if}}
    </div>

    {{#if isType.gear}}
    <h3>Utilisation (soins)</h3>
    <div class="details-grid">
      <label>VIT rendue <input type="number" name="system.use.vit" value="{{system.use.vit}}" min="0"></label>
      <label class="checkbox"><input type="checkbox" name="system.use.vitFull" {{checked system.use.vitFull}}> Toute la VIT</label>
      <label>ENE rendue <input type="number" name="system.use.ene" value="{{system.use.ene}}" min="0"></label>
      <label class="checkbox"><input type="checkbox" name="system.use.eneFull" {{checked system.use.eneFull}}> Toute l'ENE</label>
      <label>Relève un KO (% VIT max) <input type="number" name="system.use.revive" value="{{system.use.revive}}" min="0" max="100"></label>
      <label class="checkbox" data-tooltip="Consommable tenu (Jus de Baie) : n'utilise pas l'action du Dresseur"><input type="checkbox" name="system.use.free" {{checked system.use.free}}> Tenu, sans action</label>
      <label class="wide">Guérit
        <multi-checkbox name="system.use.cures">
          {{#each cureChoices as |c|}}<option value="{{c.id}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>{{/each}}
        </multi-checkbox>
      </label>
    </div>
    <h3>Objet tenu</h3>
    <div class="details-grid">
      <label>Renforce le Type <select name="system.boostType">{{selectOptions boostTypes selected=system.boostType}}</select></label>
      <label>Bonus de dégâts <input type="number" name="system.boost" value="{{system.boost}}"></label>
    </div>
    <p class="hint">Un objet tenu qui renforce un Type donne +2 dégâts aux attaques de ce Type (8.7).</p>
    {{/if}}
    <div class="details-grid">
    </div>

    {{#if isType.attack}}
    <header class="item-group-header">
      <h3>Effets quand la capacité touche</h3>
      {{#if editable}}<button type="button" class="icon" data-action="addEffect" data-tooltip="Ajouter un effet"><i class="fa-solid fa-plus"></i></button>{{/if}}
    </header>
    <ul class="hk-effects">
      {{#each effects as |e|}}
      <li data-effect-index="{{e.index}}">
        <select data-effect-field="target">{{selectOptions @root.effectChoices.targets selected=e.target}}</select>
        <select data-effect-field="kind">{{selectOptions @root.effectChoices.kinds selected=e.kind}}</select>
        {{#if e.isStat}}
        <select data-effect-field="stat">{{selectOptions @root.effectChoices.stats selected=e.stat}}</select>
        <input type="number" data-effect-field="value" value="{{e.value}}" min="-6" max="6">
        {{else}}
        <select data-effect-field="status">{{selectOptions @root.effectChoices.statuses selected=e.status}}</select>
        {{/if}}
        <label class="checkbox" data-tooltip="Seulement si le jet d'effet secondaire réussit ({{@root.system.effectChance}} %)">
          <input type="checkbox" data-effect-field="secondary" {{checked e.secondary}}> Chance</label>
        {{#if @root.editable}}<button type="button" class="icon" data-action="removeEffect" data-tooltip="Supprimer"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>
      {{else}}
      <li class="hint">Aucun effet automatique.</li>
      {{/each}}
    </ul>
    {{/if}}

    <h3>Description</h3>
    {{> "hk-editor" field="description" value=system.description enriched=enrichedDescription editable=editable uuid=item.uuid}}
  </div>
</div>
