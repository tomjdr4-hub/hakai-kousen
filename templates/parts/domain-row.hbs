<tr>
  <th>{{label}}</th>
  <td><input type="number" name="system.{{group}}.{{key}}.level" value="{{level}}" min="0"></td>
  <td><input type="text" name="system.{{group}}.{{key}}.spec" value="{{spec}}"></td>
  <td><button type="button" class="roll" data-action="rollDomain" data-group="{{group}}" data-key="{{key}}" data-tooltip="Lancer {{label}}"><i class="fa-solid fa-dice-d10"></i></button></td>
</tr>
