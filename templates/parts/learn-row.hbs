<li class="learn {{#if known}}known{{/if}} {{#if (eq state "locked")}}locked{{/if}} {{#if (eq state "next")}}next{{/if}}">
  <span class="learn-level">{{#if (eq source "ct")}}CT {{/if}}{{level}}</span>
  <span class="item-name">{{name}}</span>
  {{#if type}}<span class="type-badge type-{{type}}">{{typeLabel}}</span>{{/if}}
  {{#if byLevel}}{{#unless known}}<span class="learn-cost">{{#if cost}}{{cost}} XP{{else}}gratuit{{/if}}</span>{{/unless}}{{/if}}
  {{#if known}}<i class="fa-solid fa-check" data-tooltip="Déjà connue"></i>
  {{else if byLevel}}
    {{#if (eq state "locked")}}<i class="fa-solid fa-lock" data-tooltip="Apprenez d'abord : {{blocker}}"></i>
    {{else if editable}}<button type="button" class="icon" data-action="learnNext" data-index="{{index}}" data-tooltip="Apprendre : {{#if cost}}{{cost}} XP Pokémon{{else}}gratuit{{/if}}"><i class="fa-solid fa-plus"></i></button>{{/if}}
  {{else if editable}}<button type="button" class="icon" data-action="learnFromCompendium" data-uuid="{{uuid}}" data-name="{{name}}" data-tooltip="Ajouter (CT, œuf, tutorat : selon la fiction)"><i class="fa-solid fa-plus"></i></button>{{/if}}
</li>
